<?xml version="1.0"?>
<launch>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="gui" value="true"/>
    <arg name="verbose" value="true"/>
  </include>

  <node name="spawn_clover" pkg="pipeline_monitoring" type="spawn_clover.py" 
        output="screen" launch-prefix="bash -c 'sleep 10; $0 $@'"/>

  <node name="generate_pipeline" pkg="pipeline_monitoring" type="generate_world.py" 
        output="screen" launch-prefix="bash -c 'sleep 12; $0 $@'"/>

  <node name="create_aruco" pkg="pipeline_monitoring" type="use_real_aruco_models_fixed.py" 
        output="screen" launch-prefix="bash -c 'sleep 15; $0 $@'"/>
</launch>
