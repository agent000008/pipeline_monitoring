<?xml version="1.0"?>
<launch>
  <!-- Start Gazebo with empty world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
    <arg name="verbose" value="true"/>
  </include>

  <!-- Load Clover drone model -->
  <param name="robot_description" command="$(find xacro)/xacro '$(find clover_description)/urdf/clover/clover4.xacro' simulation:=true" />

  <!-- Spawn Clover in Gazebo -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-param robot_description -urdf -model clover -x 0 -y 0 -z 0.5 -Y 0"
        respawn="false" output="screen"/>

  <!-- Generate pipeline world after delay -->
  <node name="generate_world" pkg="pipeline_monitoring" type="generate_world.py" 
        output="screen" launch-prefix="bash -c 'sleep 8; $0 $@'"/>
</launch>
